{UTF-8}
********************************************************
	.1_Trabajo_y_retrabajo
********************************************************~
		1 Trabajo y retrabajo
	|

Funcionalidades Pendientes=
	INTEG(Llegada de Funcionalidades+Descubrimiento de Defectos-Entrega Correcta-Generacion de Defectos, PENDIENTES INICIALES)
	~	tarea
	~	STOCK. Backlog: trabajo nuevo más retrabajo descubierto que espera ser \
		desarrollado.
	|

PENDIENTES INICIALES=
	15.7
	~	tarea [0,200]
	~	Backlog al inicio. 15,7 es el valor de equilibrio sin empuje: backlog, \
		defectos y equipo arrancan en reposo. La deuda no: con la política 0 \
		crece lentamente (30 a 55 tareas en dos años), aunque su densidad casi \
		no cambia porque el sistema también crece.
	|

Funcionalidades Entregadas=
	INTEG(Entrega Correcta, 0)
	~	tarea
	~	STOCK (acumulador). Trabajo terminado sin defectos: valor entregado al \
		negocio desde la semana 0.
	|

Defectos No Descubiertos=
	INTEG(Generacion de Defectos-Descubrimiento de Defectos, DEFECTOS INICIALES)
	~	tarea
	~	STOCK. Trabajo que se dio por terminado pero tiene errores ocultos; \
		volverá al backlog como retrabajo (ciclo de retrabajo).
	|

DEFECTOS INICIALES=
	5.1
	~	tarea [0,50]
	~	Defectos ocultos al inicio. 5,1 es el valor de equilibrio sin empuje.
	|

DEMANDA BASE=
	7
	~	tarea/Week [0,20]
	~	Funcionalidades nuevas que pide el negocio cada semana en condiciones \
		normales.
	|

AUMENTO DE DEMANDA=
	0.7
	~	Dmnl [0,1.5]
	~	Aumento relativo de la demanda durante el empuje comercial (0,7 = 70 % \
		más). Con la política 0, el umbral de la trampa está entre 0,58 (el \
		equipo se recupera) y 0,60 (queda atrapado).
	|

INICIO DEL EMPUJE=
	12
	~	Week [0,100]
	~	Semana en que empieza el empuje comercial.
	|

DURACION DEL EMPUJE=
	26
	~	Week [0,100]
	~	Semanas que dura el empuje comercial.
	|

Llegada de Funcionalidades=
	DEMANDA BASE*(1+AUMENTO DE DEMANDA*(STEP(1, INICIO DEL EMPUJE)-STEP(1, INICIO DEL EMPUJE+DURACION DEL EMPUJE)))
	~	tarea/Week
	~	FLUJO. Demanda de trabajo nuevo: nivel base más un pulso temporal (el \
		empuje).
	|

TIEMPO MINIMO DE DESARROLLO=
	2
	~	Week [0.5,8]
	~	Lo mínimo que tarda una tarea en atravesar el flujo de trabajo \
		(diseño, código, revisión, despliegue).
	|

Tasa de Desarrollo=
	MIN(Funcionalidades Pendientes/TIEMPO MINIMO DE DESARROLLO, Capacidad para Funcionalidades/Esfuerzo Relativo por Tarea)
	~	tarea/Week
	~	Tareas terminadas por semana (correctas o con defectos). La limita el \
		trabajo disponible o la capacidad, lo que sea menor.
	|

Fraccion de Defectos=
	MIN(0.9, FRACCION DE DEFECTOS BASE*(1+SENSIBILIDAD DEFECTOS A DEUDA*Densidad de Deuda)*(1+SENSIBILIDAD DEFECTOS A PRESION*Exceso de Presion))
	~	Dmnl
	~	Fracción del trabajo terminado que sale con defectos ocultos. Sube con \
		la densidad de deuda y con la presión.
	|

FRACCION DE DEFECTOS BASE=
	0.1
	~	Dmnl [0,0.5]
	~	Fracción de defectos sin deuda ni presión.
	|

SENSIBILIDAD DEFECTOS A DEUDA=
	3
	~	Dmnl [0,10]
	~	Aumento relativo de defectos por unidad de densidad de deuda.
	|

SENSIBILIDAD DEFECTOS A PRESION=
	0.5
	~	Dmnl [0,3]
	~	Aumento relativo de defectos por unidad de exceso de presión.
	|

Entrega Correcta=
	Tasa de Desarrollo*(1-Fraccion de Defectos)
	~	tarea/Week
	~	FLUJO. Trabajo que sale bien.
	|

Generacion de Defectos=
	Tasa de Desarrollo*Fraccion de Defectos
	~	tarea/Week
	~	FLUJO. Trabajo que sale con errores ocultos.
	|

TIEMPO DE DESCUBRIMIENTO=
	6
	~	Week [1,26]
	~	Tiempo medio hasta que un defecto aparece (pruebas, usuarios, \
		incidentes).
	|

Descubrimiento de Defectos=
	Defectos No Descubiertos/TIEMPO DE DESCUBRIMIENTO
	~	tarea/Week
	~	FLUJO. Defectos que aparecen y vuelven al backlog como retrabajo.
	|

********************************************************
	.2_Presion_y_atajos
********************************************************~
		2 Presion y atajos
	|

PLAZO OBJETIVO=
	4
	~	Week [1,12]
	~	Semanas de trabajo en backlog que el negocio considera aceptables.
	|

Capacidad Percibida=
	SMOOTHI(Capacidad para Funcionalidades, TIEMPO DE PERCEPCION, Capacidad*(1-Fraccion de Refactor Deseada))
	~	tarea/Week
	~	Capacidad para funcionalidades que el equipo y la gerencia creen \
		tener: promedio de las últimas semanas. Excluye la parte dedicada a \
		refactorizar. Se usa SMOOTHI con valor inicial explícito para evitar \
		un ciclo de inicialización (la refactorización depende de la presión).
	|

TIEMPO DE PERCEPCION=
	4
	~	Week [1,12]
	~	Retardo con que se percibe la capacidad real.
	|

Presion de Cronograma=
	Funcionalidades Pendientes/(Capacidad Percibida*PLAZO OBJETIVO)
	~	Dmnl
	~	Backlog dividido entre lo que el equipo cree sacar en el plazo \
		objetivo. 1 = aceptable; mayor que 1 = el equipo va atrasado.
	|

PRESION MAXIMA=
	3
	~	Dmnl [1,5]
	~	Tope de la presión efectiva.
	|

Exceso de Presion=
	MAX(0, MIN(Presion de Cronograma, PRESION MAXIMA)-1)
	~	Dmnl
	~	Cuánto supera la presión el nivel aceptable. Por debajo de 1 vale 0: \
		un umbral.
	|

FRACCION DE ATAJOS BASE=
	0.05
	~	Dmnl [0,0.5]
	~	Atajos tomados aun sin presión: deuda inadvertida y erosión normal del \
		diseño.
	|

SENSIBILIDAD DE ATAJOS A PRESION=
	0.3
	~	Dmnl [0,1]
	~	Aumento de la fracción de atajos por unidad de exceso de presión: \
		deuda deliberada.
	|

Fraccion de Atajos=
	MIN(0.8, FRACCION DE ATAJOS BASE+SENSIBILIDAD DE ATAJOS A PRESION*Exceso de Presion)
	~	Dmnl
	~	Fracción del trabajo hecho 'rápido y sucio'.
	|

AHORRO POR ATAJO=
	0.5
	~	Dmnl [0,0.9]
	~	Esfuerzo que se ahorra en una tarea hecha con atajo (0,5 = la mitad).
	|

Esfuerzo Relativo por Tarea=
	1-Fraccion de Atajos*AHORRO POR ATAJO
	~	Dmnl
	~	Esfuerzo medio por tarea frente al normal. Menor que 1: los atajos \
		aceleran HOY (bucle de alivio B2).
	|

********************************************************
	.3_Deuda_tecnica
********************************************************~
		3 Deuda tecnica
	|

Deuda Tecnica=
	INTEG(Acumulacion de Deuda-Refactorizacion, DEUDA INICIAL)
	~	tarea
	~	STOCK. Principal de la deuda: esfuerzo, en tareas, necesario para \
		dejar el código como debería estar.
	|

DEUDA INICIAL=
	30
	~	tarea [0,500]
	~	Deuda heredada al inicio (densidad inicial del 3 %).
	|

DEUDA POR ATAJO=
	0.6
	~	Dmnl [0,2]
	~	Tareas de deuda que deja cada tarea hecha con atajo.
	|

Acumulacion de Deuda=
	Tasa de Desarrollo*Fraccion de Atajos*DEUDA POR ATAJO
	~	tarea/Week
	~	FLUJO. Deuda nueva que entra con cada atajo.
	|

TAMANO INICIAL DEL SISTEMA=
	1000
	~	tarea [100,5000]
	~	Tamaño del sistema existente, en tareas equivalentes.
	|

Tamano del Sistema=
	TAMANO INICIAL DEL SISTEMA+Funcionalidades Entregadas
	~	tarea
	~	Código base total. Supuesto simplificador: el código nuevo sin atajos \
		es limpio y 'diluye' la deuda.
	|

Densidad de Deuda=
	Deuda Tecnica/Tamano del Sistema
	~	Dmnl
	~	Deuda por unidad de sistema. Es lo que estorba al trabajar.
	|

SENSIBILIDAD PRODUCTIVIDAD A DEUDA=
	8
	~	Dmnl [0,20]
	~	Intensidad del 'interés' de la deuda: cuánto frena al equipo cada \
		unidad de densidad.
	|

Efecto de la Deuda en Productividad=
	1/(1+SENSIBILIDAD PRODUCTIVIDAD A DEUDA*Densidad de Deuda)
	~	Dmnl
	~	Multiplicador de productividad: 1 = sin freno; 0,5 = todo cuesta el \
		doble. Con densidad 0,03 vale 0,81.
	|

POLITICA DE REFACTOR=
	0
	~	Dmnl [0,2,1]
	~	0 = no se refactoriza. 1 = se dedica una fracción fija de la \
		capacidad. 2 = se busca una densidad de deuda objetivo (búsqueda de \
		objetivo).
	|

FRACCION REFACTOR FIJA=
	0.15
	~	Dmnl [0,0.5]
	~	Política 1: fracción de la capacidad que se quiere dedicar a \
		refactorizar. El pago real nunca supera Deuda Tecnica/TIEMPO MINIMO DE \
		REFACTOR: con poca deuda, parte de esa fracción queda libre para \
		funcionalidades.
	|

DENSIDAD OBJETIVO=
	0.02
	~	Dmnl [0,0.2]
	~	Política 2: densidad de deuda que el equipo quiere mantener.
	|

GANANCIA DE REFACTOR=
	8
	~	Dmnl [0,20]
	~	Política 2: fracción de capacidad asignada por unidad de exceso de \
		densidad sobre el objetivo.
	|

Fraccion de Refactor Deseada=
	IF THEN ELSE(POLITICA DE REFACTOR=1, FRACCION REFACTOR FIJA, IF THEN ELSE(POLITICA DE REFACTOR=2, MIN(0.5, MAX(0, GANANCIA DE REFACTOR*(Densidad de Deuda-DENSIDAD OBJETIVO))), 0))
	~	Dmnl
	~	Fracción de capacidad que la política quiere dedicar a pagar deuda.
	|

RECORTE DE REFACTOR POR PRESION=
	1
	~	Dmnl [0,1]
	~	0 = la refactorización se protege. 1 = bajo presión se sacrifica ('no \
		hay tiempo para afilar el hacha').
	|

Fraccion de Refactor=
	Fraccion de Refactor Deseada/(1+RECORTE DE REFACTOR POR PRESION*Exceso de Presion)
	~	Dmnl
	~	Fracción de capacidad que realmente se dedica a refactorizar, tras el \
		posible recorte por presión.
	|

TIEMPO MINIMO DE REFACTOR=
	4
	~	Week [1,26]
	~	Tiempo mínimo para pagar la deuda existente: limita la refactorización \
		a Deuda/4 por semana.
	|

Refactorizacion=
	MIN(Capacidad*Fraccion de Refactor, Deuda Tecnica/TIEMPO MINIMO DE REFACTOR)
	~	tarea/Week
	~	FLUJO. Deuda que se paga por semana.
	|

Capacidad para Funcionalidades=
	Capacidad-Refactorizacion
	~	tarea/Week
	~	Capacidad que queda para trabajo nuevo y retrabajo, después de \
		refactorizar.
	|

********************************************************
	.4_Equipo_y_ley_de_Brooks
********************************************************~
		4 Equipo y ley de Brooks
	|

Personal Novato=
	INTEG(Contratacion-Asimilacion, NOVATOS INICIALES)
	~	persona
	~	STOCK. Personas recién llegadas que aún no dominan el sistema.
	|

NOVATOS INICIALES=
	0.36
	~	persona [0,10]
	~	Novatos al inicio. 0,36 es el equilibrio de reemplazar la rotación \
		(personas-equivalentes en promedio).
	|

Personal Experimentado=
	INTEG(Asimilacion-Rotacion, PERSONAL INICIAL)
	~	persona
	~	STOCK. Conocimiento del equipo: personas que ya dominan el sistema.
	|

PERSONAL INICIAL=
	10
	~	persona [1,50]
	~	Personal experimentado al inicio.
	|

Personal Total=
	Personal Novato+Personal Experimentado
	~	persona
	~	Tamaño del equipo.
	|

POLITICA DE CONTRATACION=
	0
	~	Dmnl [0,1,1]
	~	0 = solo se reemplaza a quien se va. 1 = se contrata más gente cuando \
		hay presión (activa la ley de Brooks).
	|

SENSIBILIDAD DE CONTRATACION=
	1
	~	Dmnl [0,2]
	~	Política 1: personal adicional deseado, relativo al equipo inicial, \
		por unidad de exceso de presión.
	|

Personal Deseado=
	(PERSONAL INICIAL+NOVATOS INICIALES)*(1+POLITICA DE CONTRATACION*SENSIBILIDAD DE CONTRATACION*Exceso de Presion)
	~	persona
	~	Tamaño de equipo que la gerencia quiere. Supuesto: no hay despidos; si \
		sobra gente, el equipo solo se achica por rotación.
	|

TIEMPO DE CONTRATACION=
	4
	~	Week [1,12]
	~	Tiempo para cerrar una brecha de personal.
	|

Contratacion=
	MAX(0, Rotacion+(Personal Deseado-Personal Total)/TIEMPO DE CONTRATACION)
	~	persona/Week
	~	FLUJO. Ingresos al equipo: se repone a quien se va y se cierra la \
		brecha con el personal deseado (anclaje y ajuste).
	|

TIEMPO DE ASIMILACION=
	12
	~	Week [2,52]
	~	Tiempo medio para que un novato domine el sistema.
	|

Asimilacion=
	Personal Novato/TIEMPO DE ASIMILACION
	~	persona/Week
	~	FLUJO. Novatos que se vuelven experimentados: el conocimiento se \
		construye con tiempo.
	|

FRACCION DE ROTACION=
	0.003
	~	1/Week [0,0.05]
	~	Fracción del personal experimentado que se va cada semana (0,003 = \
		unos 15 % al año).
	|

Rotacion=
	Personal Experimentado*FRACCION DE ROTACION
	~	persona/Week
	~	FLUJO. Salida de conocimiento del equipo.
	|

PRODUCTIVIDAD RELATIVA NOVATO=
	0.2
	~	Dmnl [0,1]
	~	Productividad de un novato frente a un experimentado.
	|

FRACCION DE MENTORIA=
	0.4
	~	Dmnl [0,1]
	~	Tiempo de un experimentado que consume cada novato en entrenamiento.
	|

Personas Efectivas=
	MAX(0, Personal Experimentado+Personal Novato*(PRODUCTIVIDAD RELATIVA NOVATO-FRACCION DE MENTORIA))
	~	persona
	~	Equivalente en personas experimentadas, descontando la mentoría. Cada \
		novato aporta 0,2 y consume 0,4 de un experto: resta 0,2 mientras sea \
		novato. Primer argumento de Brooks.
	|

COSTO DE COMUNICACION=
	0.015
	~	1/persona [0,0.05]
	~	Fracción de tiempo que cada persona dedica a coordinarse, por cada \
		persona del equipo (incluida ella misma, como aproximación). Segundo \
		argumento de Brooks.
	|

Sobrecarga de Comunicacion=
	MIN(0.6, COSTO DE COMUNICACION*Personal Total)
	~	Dmnl
	~	Fracción del tiempo que se va en coordinarse; crece con el tamaño del \
		equipo.
	|

PRODUCTIVIDAD BASE=
	1.42
	~	tarea/(persona*Week) [0.1,5]
	~	Tareas por persona experimentada y por semana, sin deuda ni \
		sobrecarga.
	|

Capacidad=
	Personas Efectivas*PRODUCTIVIDAD BASE*(1-Sobrecarga de Comunicacion)*Efecto de la Deuda en Productividad
	~	tarea/Week
	~	Capacidad real de trabajo del equipo (antes de repartirla entre \
		refactorizar y funcionalidades).
	|

********************************************************
	.5_Indicadores
********************************************************~
		5 Indicadores
	|

Esfuerzo Acumulado=
	INTEG(Esfuerzo Semanal, 0)
	~	persona*Week
	~	STOCK (acumulador). Personas-semana pagadas desde el inicio: el costo \
		de la política.
	|

Esfuerzo Semanal=
	Personal Total
	~	persona
	~	FLUJO. Personas pagadas esta semana (persona-semana por semana).
	|

Productividad por Persona=
	Capacidad/Personal Total
	~	tarea/(persona*Week)
	~	Indicador: cuánto rinde cada persona del equipo esta semana.
	~	:SUPPLEMENTARY
	|

Eficiencia Acumulada=
	ZIDZ(Funcionalidades Entregadas, Esfuerzo Acumulado)
	~	tarea/(persona*Week)
	~	Indicador: tareas correctas entregadas por persona-semana pagada desde \
		el inicio. Compárelo solo entre políticas con la misma demanda y junto \
		con el estado final (backlog, defectos y deuda): no descuenta lo que \
		queda pendiente.
	~	:SUPPLEMENTARY
	|

Fraccion de Retrabajo=
	ZIDZ(Descubrimiento de Defectos, Tasa de Desarrollo)
	~	Dmnl
	~	Indicador: parte del trabajo de la semana que corresponde a rehacer \
		defectos descubiertos (aproximación).
	~	:SUPPLEMENTARY
	|

********************************************************
	.Control
********************************************************~
		Control
	|

FINAL TIME=
	104
	~	Week
	~	Dos años.
	|

INITIAL TIME=
	0
	~	Week
	~	Inicio de la simulación.
	|

SAVEPER=
	1
	~	Week [0,?]
	~	Frecuencia de guardado.
	|

TIME STEP=
	0.125
	~	Week [0,?]
	~	Paso de integración. Pruebe 0,0625: los resultados no deben cambiar.
	|

