{UTF-8}
********************************************************
	.Estructura
********************************************************~
		Arquetipo de busqueda de objetivo (convergencia a un valor de referencia).
	|

STOCK= INTEG (ENTRADA-SALIDA,
		STOCK INICIAL)
	~	unidades
	~	Nivel que se quiere mantener cerca de la referencia (temperatura, \
		recurso renovable, inventario...).
	|

STOCK INICIAL=1000
	~	unidades [0,4000]
	~	Valor inicial del stock. Pruebe valores por debajo y por encima de la \
		referencia.
	|

REFERENCIA DE STOCK=2000
	~	unidades [0,4000]
	~	Nivel deseado u objetivo del stock.
	|

ERROR=REFERENCIA DE STOCK-STOCK
	~	unidades
	~	Desfase entre lo deseado y lo que hay. Positivo: falta stock. \
		Negativo: sobra stock.
	|

TASA DE ENTRADA=0.2
	~	1/Day [0,1]
	~	Fraccion del error que se corrige cada dia (en la diapositiva, 0,2). \
		Su inverso es el tiempo de ajuste: 1/0,2 = 5 dias.
	|

AJUSTE POR ERROR=TASA DE ENTRADA*ERROR
	~	unidades/Day
	~	Correccion proporcional al desfase: ENTRADA(t) = 0,2 * ERROR(t) en la \
		diapositiva.
	|

ESTRATEGIA DE CONTROL=1
	~	Dmnl [1,2,1]
	~	1 = solo ajuste proporcional (como la diapositiva): el stock se \
		estabiliza por debajo de la referencia. 2 = ajuste mas reposicion de lo \
		que sale: el stock alcanza la referencia.
	|

REPOSICION DE SALIDA=IF THEN ELSE(ESTRATEGIA DE CONTROL=2, SALIDA, 0)
	~	unidades/Day
	~	Con la estrategia 2, la entrada repone primero lo que se pierde por la \
		salida y luego corrige el error.
	|

ENTRADA=MAX(0, REPOSICION DE SALIDA+AJUSTE POR ERROR)
	~	unidades/Day
	~	Flujo de entrada. MAX(0, ...) impide una entrada negativa: si sobra \
		stock, la entrada se cierra y solo actua la salida.
	|

TASA DE SALIDA=0.1
	~	1/Day [0,1]
	~	Fraccion del stock que se pierde cada dia (en la diapositiva, 0,1).
	|

SALIDA=TASA DE SALIDA*STOCK
	~	unidades/Day
	~	Perdida proporcional al stock: SALIDA(t) = 0,1 * STOCK(t).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 50
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 0.5
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Day [0,?]
	~	The time step for the simulation.
	|

